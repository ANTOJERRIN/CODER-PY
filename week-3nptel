def contracting(l):
    if len(l) < 3:
        return True
    
    for i in range(len(l) - 2):
        diff1 = abs(l[i] - l[i+1])
        diff2 = abs(l[i+1] - l[i+2])
        if diff1 <= diff2:
            return False
            
    return True

def counthv(l):
    hc = 0
    vc = 0
    
    for i in range(1, len(l) - 1):
        if l[i] > l[i-1] and l[i] > l[i+1]:
            hc += 1
        elif l[i] < l[i-1] and l[i] < l[i+1]:
            vc += 1
            
    return [hc, vc]

def leftrotate(m):
    n = len(m)
    new_m = []
    
    for i in range(n):
        new_row = []
        for j in range(n):
            # Extract the correct element to form the counter-clockwise rotated matrix
            new_row.append(m[j][n - 1 - i])
        new_m.append(new_row)
        
    return new_m